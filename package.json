{
  "name": "ax",
  "module": "src/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build:js": "mkdir -p dist && bun build src/index.js --outfile dist/ax.js --target browser",
    "build:min": "bun build src/index.js --outfile dist/ax.min.js --target browser --minify",
    "build": "rm -rf dist && bun run build:js && bun run build:min",
    "dev": "bun run --watch src/index.js",
    "start": "bun run src/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5"
  }
}
